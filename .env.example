
AUTH_SECRET=
DATABASE_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend (transactional email). Get a key at https://resend.com/api-keys
# RESEND_FROM_EMAIL must use a domain you've verified in Resend; the default
# onboarding@resend.dev sandbox only delivers to your own Resend account email.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Hostel Mess <onboarding@resend.dev>"

# Vercel Cron. Secret used to authorize the daily birthday cron job.
# Vercel sends it as "Authorization: Bearer $CRON_SECRET" to /api/cron/*.
CRON_SECRET=

# Optional: Upstash Redis cache for the leaderboard and birthday widgets.
# Leave both blank to run without caching - the app falls back to querying
# Postgres directly.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Public base URL for links sent by email (invitations). Set this per
# environment - it is what stops a production invite pointing at localhost.
# On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL if unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web push (VAPID). Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_WEB_PUSH_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:you@example.com
